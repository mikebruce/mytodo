<UserControl
    x:Class="MyToDo.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="clr-namespace:MyToDo.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:MyToDo.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:pass="clr-namespace:MyToDo.Extensions"
    xmlns:prism="http://prismlibrary.com/"
    Width="600"
    Height="350"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <md:SnackbarMessageTypeConverter x:Key="SnackBarKindToBrush" />
    </UserControl.Resources>
    <prism:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="Width" Value="600" />
            <Setter Property="Height" Value="350" />
            <Setter Property="SizeToContent" Value="WidthAndHeight" />
            <Setter Property="ResizeMode" Value="NoResize" />
            <Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen" />
        </Style>
    </prism:Dialog.WindowStyle>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Image Margin="50" Source="/Images/login.png" />
        <md:Snackbar
            x:Name="LoginSnackbar"
            Grid.ColumnSpan="2"
            MaxWidth="420"
            Margin="0,0,0,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            VerticalContentAlignment="Center"
            Panel.ZIndex="1"
            CornerRadius="5"
            FontSize="14"
            Foreground="White"
            MessageQueue="{md:MessageQueue}">
            <md:Snackbar.Style>
                <Style TargetType="md:Snackbar">
                    <Setter Property="Background" Value="#FF1E1E1E" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SnackBarKind}" Value="Success">
                            <Setter Property="Background" Value="#FF0CA0FF" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SnackBarKind}" Value="Warning">
                            <Setter Property="Background" Value="#FFEF6C00" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SnackBarKind}" Value="Error">
                            <Setter Property="Background" Value="#FFC62828" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SnackBarKind}" Value="Info">
                            <Setter Property="Background" Value="Chartreuse" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SnackBarKind}" Value="Default">
                            <Setter Property="Background" Value="#EE1E1E1E" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </md:Snackbar.Style>
        </md:Snackbar>     
        <md:Transitioner Grid.Column="1" SelectedIndex="{Binding SelectedIndex}">
            <md:TransitionerSlide>
                <DockPanel Margin="15" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,10"
                        DockPanel.Dock="Top"
                        FontSize="22"
                        FontWeight="Bold"
                        Text="欢迎使用" />

                    <TextBox
                        Margin="0,10"
                        md:HintAssist.Hint="请输入账号"
                        DockPanel.Dock="Top"
                        Text="{Binding Account}" />
                    <PasswordBox
                        Margin="0,10"
                        md:HintAssist.Hint="请输入密码"
                        pass:PasswordExtensions.Password="{Binding PassWord, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                        DockPanel.Dock="Top">
                        <i:Interaction.Behaviors>
                            <pass:PasswordBehavior />
                        </i:Interaction.Behaviors>
                    </PasswordBox>
                    <Button
                        Command="{Binding ExecuteCommand}"
                        CommandParameter="Login"
                        Content="登录系统"
                        DockPanel.Dock="Top" 
                        IsDefault="True"/>
                    <DockPanel Margin="0,10" LastChildFill="False">
                        <TextBlock FontSize="14" Text="注册账号">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding ExecuteCommand}" CommandParameter="GoRegister" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBlock>

                        <TextBlock
                            DockPanel.Dock="Right"
                            FontSize="14"
                            Text="忘记密码">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding ExecuteCommand}" CommandParameter="Forget" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </TextBlock>
                    </DockPanel>
                </DockPanel>
            </md:TransitionerSlide>
            <md:TransitionerSlide>
                <DockPanel
                    Margin="0,10,0,0"
                    VerticalAlignment="Center"
                    LastChildFill="False">
                    <TextBlock
                        DockPanel.Dock="Top"
                        FontSize="22"
                        FontWeight="Bold"
                        Text="注册账号" />
                    <TextBox
                        Margin="0,10"
                        md:HintAssist.Hint="请输入账号"
                        DockPanel.Dock="Top"
                        Text="{Binding RegisterUserDto.Account}" />
                    <TextBox
                        Margin="0,10"
                        md:HintAssist.Hint="请输入姓名"
                        DockPanel.Dock="Top"
                        Text="{Binding RegisterUserDto.UserName}" />

                    <PasswordBox
                        Margin="0,5"
                        md:HintAssist.Hint="请输入密码"
                        pass:PasswordExtensions.Password="{Binding RegisterUserDto.PassWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        DockPanel.Dock="Top">
                        <i:Interaction.Behaviors>
                            <pass:PasswordBehavior />
                        </i:Interaction.Behaviors>
                    </PasswordBox>
                    <PasswordBox
                        Margin="0,5"
                        md:HintAssist.Hint="请再次输入密码"
                        pass:PasswordExtensions.Password="{Binding RegisterUserDto.NewPassWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        DockPanel.Dock="Top">
                        <i:Interaction.Behaviors>
                            <pass:PasswordBehavior />
                        </i:Interaction.Behaviors>
                    </PasswordBox>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button
                            Width="100"
                            Margin="0,5"
                            Command="{Binding ExecuteCommand}"
                            CommandParameter="Register"
                            Content="注册账号" />
                        <Button
                            Width="100"
                            Margin="10,5,0,5"
                            Command="{Binding ExecuteCommand}"
                            CommandParameter="Return"
                            Content="返回" />
                    </StackPanel>
                </DockPanel>
            </md:TransitionerSlide>

            <md:TransitionerSlide>
                <DockPanel
                    Margin="0,10,0,0"
                    VerticalAlignment="Center"
                    LastChildFill="False">
                    <TextBlock
                        DockPanel.Dock="Top"
                        FontSize="22"
                        FontWeight="Bold"
                        Text="忘记密码" />
                    <TextBox
                        Margin="0,10"
                        md:HintAssist.Hint="请输入账号"
                        DockPanel.Dock="Top"
                        Text="{Binding RegisterUserDto.Account}" />
                    <PasswordBox
                        Margin="0,5"
                        md:HintAssist.Hint="请输入新密码"
                        pass:PasswordExtensions.Password="{Binding RegisterUserDto.PassWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        DockPanel.Dock="Top">
                        <i:Interaction.Behaviors>
                            <pass:PasswordBehavior />
                        </i:Interaction.Behaviors>
                    </PasswordBox>
                    <PasswordBox
                        Margin="0,5"
                        md:HintAssist.Hint="请再次输入新密码"
                        pass:PasswordExtensions.Password="{Binding RegisterUserDto.NewPassWord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        DockPanel.Dock="Top">
                        <i:Interaction.Behaviors>
                            <pass:PasswordBehavior />
                        </i:Interaction.Behaviors>
                    </PasswordBox>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button
                            Width="100"
                            Margin="0,5"
                            Command="{Binding ExecuteCommand}"
                            CommandParameter="Reset"
                            Content="重置密码" />

                        <Button
                            Width="100"
                            Margin="10,5,0,5"
                            Command="{Binding ExecuteCommand}"
                            CommandParameter="Return"
                            Content="返回" />
                    </StackPanel>
                </DockPanel>
            </md:TransitionerSlide>
        </md:Transitioner>
    </Grid>
</UserControl>