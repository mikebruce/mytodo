                                        </Canvas>
                                    </Grid>
                                </md:TransitioningContent>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>-->
                </ScrollViewer>

            </Grid>
        </md:DrawerHost>

    </md:DialogHost>
</UserControl>
